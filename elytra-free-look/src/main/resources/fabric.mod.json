{
  "schemaVersion": 1,
  "id": "elytrafreelook",
  "version": "${version}",
  "name": "Elytra Free Look",
  "description": "Decouples the camera from your flight direction while gliding with an elytra, letting you look around freely during flight.",
  "authors": [
    "PocketOtter"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/elytrafreelook/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.pocketotter.elytrafreelook.client.ElytraFreeLookClient"
    ],
    "modmenu": [
      "dev.pocketotter.elytrafreelook.client.config.ElytraFreeLookModMenuIntegration"
    ]
  },
  "mixins": [
    "elytrafreelook.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
